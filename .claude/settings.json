{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(npm run dev)",
      "Edit(/docs/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(/secrets/**)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)"
    ]
  }
}
